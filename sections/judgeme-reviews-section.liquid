        <button type="button" class="jmr-wr-close" id="jmr-wr-close-{{ section.id }}" aria-label="Close">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" width="18" height="18"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
      </div>
      <div class="jmr-wr-body" id="jmr-wr-body-{{ section.id }}">
        <div>
          <p class="jmr-wr-stars-label">Your Rating <span style="color:#ef4444">*</span></p>
          <div class="jmr-wr-stars" id="jmr-wr-stars-{{ section.id }}">
            <input type="radio" name="jmr-wr-rating-{{ section.id }}" id="jmr-s5-{{ section.id }}" value="5"><label for="jmr-s5-{{ section.id }}" title="5 stars">★</label>
            <input type="radio" name="jmr-wr-rating-{{ section.id }}" id="jmr-s4-{{ section.id }}" value="4"><label for="jmr-s4-{{ section.id }}" title="4 stars">★</label>
            <input type="radio" name="jmr-wr-rating-{{ section.id }}" id="jmr-s3-{{ section.id }}" value="3"><label for="jmr-s3-{{ section.id }}" title="3 stars">★</label>
            <input type="radio" name="jmr-wr-rating-{{ section.id }}" id="jmr-s2-{{ section.id }}" value="2"><label for="jmr-s2-{{ section.id }}" title="2 stars">★</label>
            <input type="radio" name="jmr-wr-rating-{{ section.id }}" id="jmr-s1-{{ section.id }}" value="1"><label for="jmr-s1-{{ section.id }}" title="1 star">★</label>
          </div>
        </div>
        <div class="jmr-wr-row">
          <div class="jmr-wr-field">
            <label for="jmr-wr-name-{{ section.id }}">Name <span style="color:#ef4444">*</span></label>
            <input type="text" id="jmr-wr-name-{{ section.id }}" placeholder="Your name" autocomplete="name">
          </div>
          <div class="jmr-wr-field">
            <label for="jmr-wr-email-{{ section.id }}">Email <span style="color:#ef4444">*</span></label>
            <input type="email" id="jmr-wr-email-{{ section.id }}" placeholder="your@email.com" autocomplete="email">
          </div>
        </div>
        <div class="jmr-wr-field">
          <label for="jmr-wr-title-{{ section.id }}">Review Title</label>
          <input type="text" id="jmr-wr-title-{{ section.id }}" placeholder="Summarise your experience">
        </div>
        <div class="jmr-wr-field">
          <label for="jmr-wr-body-{{ section.id }}">Your Review <span style="color:#ef4444">*</span></label>
          <textarea id="jmr-wr-body-{{ section.id }}" placeholder="Tell others what you think about this product..."></textarea>
        </div>
        <p class="jmr-wr-error" id="jmr-wr-error-{{ section.id }}"></p>
      </div>
      <div class="jmr-wr-success" id="jmr-wr-success-{{ section.id }}">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
        <h3>Thank you for your review!</h3>
        <p>Your review has been submitted and is pending approval.</p>
      </div>
      <div class="jmr-wr-footer" id="jmr-wr-footer-{{ section.id }}">
        <button type="button" class="jmr-wr-cancel" id="jmr-wr-cancel-{{ section.id }}">Cancel</button>
        <button type="button" class="jmr-wr-submit" id="jmr-wr-submit-{{ section.id }}">Submit Review</button>
      </div>
    </div>
  </div>

  {%- comment -%} ── Photo lightbox ── {%- endcomment -%}
  <div class="jmr-lb-overlay" hidden id="jmr-lb-overlay-{{ section.id }}" role="dialog" aria-modal="true" aria-label="Customer photo viewer">
    <button class="jmr-lb-close" id="jmr-lb-close-{{ section.id }}" aria-label="Close photo viewer">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" width="22" height="22"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>
    <button class="jmr-lb-nav jmr-lb-prev" id="jmr-lb-prev-{{ section.id }}" aria-label="Previous photo">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" width="22" height="22"><polyline points="15 18 9 12 15 6"/></svg>
    </button>
    <div class="jmr-lb-content">
      <img class="jmr-lb-img" id="jmr-lb-img-{{ section.id }}" src="" alt="Customer photo">
    </div>
    <button class="jmr-lb-nav jmr-lb-next" id="jmr-lb-next-{{ section.id }}" aria-label="Next photo">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" width="22" height="22"><polyline points="9 18 15 12 9 6"/></svg>
    </button>
    <p class="jmr-lb-counter" id="jmr-lb-counter-{{ section.id }}"></p>
