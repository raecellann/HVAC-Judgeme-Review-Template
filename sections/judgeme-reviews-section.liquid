  {%- assign _via = 6 | modulo: _pvc -%}
  {%- assign _vib = 4 | modulo: _pvc -%}
  {%- assign _vic = 16 | modulo: _pvc -%}
  {%- assign _vid = 0 | modulo: _pvc -%}
  {%- assign _vie = 12 | modulo: _pvc -%}
