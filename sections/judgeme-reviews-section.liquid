  {%- assign _rv_b = _pv[_vib] -%}
  {%- assign _rv_c = _pv[_vic] -%}
  {%- assign _rv_d = _pv[_vid] -%}
  {%- assign _rv_e = _pv[_vie] -%}
  {%- capture _pta -%}{%- if _has_size_opts and _pvc > 1 -%}{%- assign _rv = _pv[_via] -%}{{- product.title | replace: _base_v.option1, _rv.option1 | replace: _base_v.option2, _rv.option2 | replace: _base_v.option3, _rv.option3 -}}{%- else -%}{{- product.title -}}{%- endif -%}{%- endcapture -%}
  {%- capture _ptb -%}{%- if _has_size_opts and _pvc > 1 -%}{%- assign _rv = _pv[_vib] -%}{{- product.title | replace: _base_v.option1, _rv.option1 | replace: _base_v.option2, _rv.option2 | replace: _base_v.option3, _rv.option3 -}}{%- else -%}{{- product.title -}}{%- endif -%}{%- endcapture -%}
  {%- capture _ptc -%}{%- if _has_size_opts and _pvc > 1 -%}{%- assign _rv = _pv[_vic] -%}{{- product.title | replace: _base_v.option1, _rv.option1 | replace: _base_v.option2, _rv.option2 | replace: _base_v.option3, _rv.option3 -}}{%- else -%}{{- product.title -}}{%- endif -%}{%- endcapture -%}
  {%- capture _ptd -%}{%- if _has_size_opts and _pvc > 1 -%}{%- assign _rv = _pv[_vid] -%}{{- product.title | replace: _base_v.option1, _rv.option1 | replace: _base_v.option2, _rv.option2 | replace: _base_v.option3, _rv.option3 -}}{%- else -%}{{- product.title -}}{%- endif -%}{%- endcapture -%}
  {%- capture _pte -%}{%- if _has_size_opts and _pvc > 1 -%}{%- assign _rv = _pv[_vie] -%}{{- product.title | replace: _base_v.option1, _rv.option1 | replace: _base_v.option2, _rv.option2 | replace: _base_v.option3, _rv.option3 -}}{%- else -%}{{- product.title -}}{%- endif -%}{%- endcapture -%}

