{%- comment -%}
  Judge.me Reviews Section — custom branded design.
  Drop-in replacement for Okendo — remove Okendo app, install Judge.me, widget auto-activates.
  HIDDEN: remove the "if false" / "endif" below to re-enable.
{%- endcomment -%}
{% if section.settings.show_reviews %}

{%- style -%}
#jmr-{{ section.id }} {
  padding-top: {{ section.settings.padding_top }}px;
  padding-bottom: {{ section.settings.padding_bottom }}px;
  padding-left: 2rem;
  padding-right: 2rem;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  color: #0f172a;
}
#jmr-{{ section.id }} *, #jmr-{{ section.id }} *::before, #jmr-{{ section.id }} *::after {
  box-sizing: border-box;
}
#jmr-{{ section.id }} h1,
#jmr-{{ section.id }} h2,
#jmr-{{ section.id }} h3,
#jmr-{{ section.id }} h4,
#jmr-{{ section.id }} p,
#jmr-{{ section.id }} ul,
#jmr-{{ section.id }} ol {
  margin: 0;
  padding: 0;
}

/* ── Header ── */
.jmr-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 1rem;
  margin-bottom: 1.75rem;
  padding-bottom: 1.75rem;
  border-bottom: 1px solid #e2e8f0;
}
.jmr-header h2 {
  font-size: clamp(2.2rem, 3.5vw, 3rem);
  font-weight: 800;
  color: #0f172a;
  line-height: 1.15;
  margin-bottom: 0.5rem;
}
.jmr-header-sub {
  color: #64748b;
  font-size: 1.25rem;
}
.jmr-verified-badge {
  display: flex;
  align-items: center;
  gap: 0.6rem;
  font-size: 1.6rem;
  font-weight: 700;
  color: #1e3a6e;
  white-space: nowrap;
  padding-top: 0.35rem;
}
.jmr-verified-badge svg { width: 22px; height: 22px; flex-shrink: 0; }

/* ── Rating summary box ── */
.jmr-summary {
  display: grid;
  grid-template-columns: 260px 1fr;
  gap: 0;
  background: #1a4a80;
  border-radius: 14px;
  margin-bottom: 3rem;
  overflow: hidden;
}
.jmr-overall {
  text-align: center;
  padding: 2.75rem 2rem;
  border-right: 1px solid rgba(255,255,255,0.2);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
  min-width: 0;
}
.jmr-big-num {
  font-size: 6.5rem;
  font-weight: 800;
  color: #fff;
  line-height: 1;
}
.jmr-star-display {
  position: relative;
  display: inline-block;
  font-size: 2.4rem;
  line-height: 1;
  margin: 0.4rem 0;
}
.jmr-star-display .bg { color: rgba(255,255,255,0.25); letter-spacing: 3px; }
.jmr-star-display .fg {
  position: absolute;
  inset: 0;
  overflow: hidden;
  white-space: nowrap;
  color: #fcd34d;
  letter-spacing: 3px;
}
.jmr-out-of {
  font-size: 1.6rem;
  color: rgba(255,255,255,0.85);
}
.jmr-total-ct {
  font-size: 1.35rem;
  color: rgba(255,255,255,0.85);
  margin-top: 0.2rem;
  white-space: nowrap;
}
.jmr-breakdown {
  padding: 2.75rem 3rem;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 1.25rem;
  min-width: 0;
}
.jmr-bar-row {
  display: flex;
  align-items: center;
  gap: 1.25rem;
  font-size: 1.5rem;
  min-width: 0;
}
.jmr-bar-lbl {
  display: flex;
  align-items: center;
  gap: 6px;
  width: 56px;
  color: #fff;
  font-weight: 700;
  flex-shrink: 0;
}
.jmr-bar-lbl .s { color: #fcd34d; font-size: 1.3rem; }
.jmr-bar {
  flex: 1;
  min-width: 0;
  height: 16px;
  border-radius: 99px;
  appearance: none;
  -webkit-appearance: none;
  border: none;
  display: block;
  overflow: hidden;
}
.jmr-bar::-webkit-progress-bar {
  background: rgba(255,255,255,0.22);
  border-radius: 99px;
}
.jmr-bar::-webkit-progress-value {
  background: #fcd34d;
  border-radius: 99px;
}
.jmr-bar::-moz-progress-bar {
  background: #fcd34d;
  border-radius: 99px;
}
.jmr-bar-meta {
  width: 150px;
  flex-shrink: 0;
  text-align: right;
  font-size: 1.3rem;
  white-space: nowrap;
}
.jmr-pct {
  color: #fcd34d;
  font-weight: 700;
}
.jmr-ct {
  color: rgba(255,255,255,0.75);
  font-weight: 400;
}

/* ── Customer photos ── */
.jmr-photos {
  margin-bottom: 3rem;
}
.jmr-photos-hd {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 1.5rem;
}
.jmr-photos-hd h3 {
  font-size: 2rem;
  font-weight: 700;
  color: #0f172a;
}
.jmr-photos-hd a {
  font-size: 1.4rem;
  font-weight: 600;
  color: #1a4fa3;
  text-decoration: none;
}
.jmr-photos-hd a:hover { text-decoration: underline; }
.jmr-photos-row {
  display: flex;
  gap: 1.25rem;
  justify-content: center;
  flex-wrap: wrap;
}
.jmr-photo-tile {
  position: relative;
  width: 160px;
  height: 160px;
  border-radius: 10px;
  overflow: hidden;
  background: #f1f5f9;
  flex-shrink: 0;
  border: 2px solid #e2e8f0;
  box-shadow: 0 2px 8px rgba(0,0,0,0.08);
  transition: border-color 0.2s, box-shadow 0.2s;
  cursor: pointer;
}
.jmr-photo-tile:hover {
  border-color: #2a74af;
  box-shadow: 0 4px 16px rgba(42,116,175,0.18);
}
.jmr-photo-tile img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}
.jmr-photo-more {
  width: 160px;
  height: 160px;
  border-radius: 10px;
  flex-shrink: 0;
  background: #eff6ff;
  border: 2px solid #bfdbfe;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  color: #1a4fa3;
  font-weight: 800;
  font-size: 1.6rem;
  cursor: pointer;
  line-height: 1.2;
}
/* ── Photo lightbox ── */
.jmr-lb-overlay {
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,0.88);
  z-index: 9999;
  display: flex;
  align-items: center;
  justify-content: center;
}
.jmr-lb-overlay[hidden] { display: none !important; }
.jmr-lb-content {
  max-width: 90vw;
  max-height: 85vh;
  display: flex;
  align-items: center;
  justify-content: center;
}
.jmr-lb-img {
  max-width: 90vw;
  max-height: 85vh;
  border-radius: 10px;
  object-fit: contain;
  display: block;
  box-shadow: 0 8px 40px rgba(0,0,0,0.5);
}
.jmr-lb-close {
  position: fixed;
  top: 1.25rem;
  right: 1.25rem;
  background: rgba(255,255,255,0.15);
  border: 1.5px solid rgba(255,255,255,0.3);
  color: #fff;
  border-radius: 50%;
  width: 44px;
  height: 44px;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  transition: background 0.15s;
}
.jmr-lb-close:hover { background: rgba(255,255,255,0.28); }
.jmr-lb-nav {
  position: fixed;
  top: 50%;
  transform: translateY(-50%);
  background: rgba(255,255,255,0.15);
  border: 1.5px solid rgba(255,255,255,0.3);
  color: #fff;
  border-radius: 50%;
  width: 48px;
  height: 48px;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  transition: background 0.15s;
}
.jmr-lb-nav:hover { background: rgba(255,255,255,0.28); }
.jmr-lb-nav[hidden] { display: none !important; }
.jmr-lb-prev { left: 1.25rem; }
.jmr-lb-next { right: 1.25rem; }
.jmr-lb-counter {
  position: fixed;
  bottom: 1.25rem;
  left: 50%;
  transform: translateX(-50%);
  color: rgba(255,255,255,0.75);
  font-size: 1.2rem;
  font-weight: 500;
  pointer-events: none;
  margin: 0;
}
.jmr-photo-more small {
  font-size: 0.8rem;
  font-weight: 600;
}

/* ── Filter tabs ── */
.jmr-filters {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  margin-top: 0.5rem;
  margin-bottom: 2.5rem;
  overflow-x: auto;
  -webkit-overflow-scrolling: touch;
  scrollbar-width: none;
}
.jmr-filters::-webkit-scrollbar { display: none; }
.jmr-filter-btn {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  padding: 0.7rem 1.4rem;
  border: 1.5px solid #e2e8f0;
  border-radius: 50px;
  background: #fff;
  color: #374151;
  font-size: 1.3rem;
  font-weight: 500;
  cursor: pointer;
  white-space: nowrap;
  transition: border-color 0.15s, color 0.15s, background 0.15s;
  line-height: 1;
}
.jmr-filter-btn:hover { border-color: #1a4fa3; color: #1a4fa3; }
.jmr-filter-btn.active { background: #1a4fa3; border-color: #1a4fa3; color: #fff; }
.jmr-filter-right { margin-left: auto; }
/* ── Filter dropdown panel ── */
.jmr-filters-outer { position: relative; }
.jmr-filter-panel {
  position: absolute;
  top: calc(100% + 8px);
  right: 0;
  background: #fff;
  border: 1.5px solid #e2e8f0;
  border-radius: 12px;
  box-shadow: 0 8px 28px rgba(0,0,0,0.13);
  padding: 1.25rem 1.5rem;
  z-index: 200;
  min-width: 210px;
}
.jmr-filter-panel[hidden] { display: none; }
.jmr-filter-panel-title {
  font-size: 1.5rem;
  font-weight: 700;
  color: #64748b;
  margin-bottom: 0.6rem;
}
.jmr-filter-option {
  display: flex;
  align-items: center;
  gap: 0.6rem;
  width: 100%;
  padding: 0.55rem 0.6rem;
  border: none;
  background: none;
  border-radius: 7px;
  cursor: pointer;
  font-size: 1.4rem;
  color: #374151;
  text-align: left;
  transition: background 0.12s, color 0.12s;
  font-family: inherit;
}
.jmr-filter-option:hover { background: #f1f5f9; color: #1a4fa3; }
.jmr-filter-option.active { background: #eff6ff; color: #1a4fa3; font-weight: 600; }
.jmr-filter-option .jmr-opt-stars { color: #f59e0b; letter-spacing: 1px; font-size: 0.95rem; }
.jmr-filter-option .jmr-opt-check { margin-left: auto; color: #1a4fa3; display: none; }
.jmr-filter-option.active .jmr-opt-check { display: block; }
.jmr-filters-toggle.has-filter { background: #eff6ff; border-color: #1a4fa3; color: #1a4fa3; }
.jmr-filter-clear-all {
  display: none;
  width: 100%;
  margin-top: 0.75rem;
  padding: 0.6rem 0.6rem;
  border: 1.5px solid #e2e8f0;
  border-radius: 7px;
  background: none;
  cursor: pointer;
  font-size: 1.35rem;
  font-family: inherit;
  color: #64748b;
  text-align: center;
  transition: background 0.12s, color 0.12s, border-color 0.12s;
}
.jmr-filter-clear-all:hover { background: #fef2f2; border-color: #fca5a5; color: #dc2626; }
.jmr-filter-panel.has-active-filter .jmr-filter-clear-all { display: block; }
.jmr-filter-panel-divider {
  border: none;
  border-top: 1px solid #e2e8f0;
  margin: 0.2rem 0;
}
.jmr-acc-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  padding: 0.55rem 0;
  border: none;
  background: none;
  cursor: pointer;
  font-family: inherit;
}
.jmr-acc-header .jmr-filter-panel-title { margin-bottom: 0; }
.jmr-acc-caret { transition: transform 0.18s; color: #94a3b8; flex-shrink: 0; }
.jmr-acc-header[aria-expanded="false"] .jmr-acc-caret { transform: rotate(-90deg); }
.jmr-acc-body { overflow: hidden; }
.jmr-acc-body[hidden] { display: none; }
.jmr-filter-empty {
  display: none;
  padding: 2.5rem 0;
  text-align: center;
  color: #94a3b8;
  font-size: 1.2rem;
}

/* ── Reviews list ── */
.jmr-review {
  padding: 3rem 0;
  border-bottom: 1px solid #e2e8f0;
}
.jmr-review:last-child { border-bottom: none; }
.jmr-review-top {
  display: flex;
  align-items: flex-start;
  gap: 1rem;
  margin-bottom: 1rem;
}
.jmr-avatar {
  width: 58px;
  height: 58px;
  border-radius: 50%;
  background: #dbeafe;
  color: #1e40af;
  font-weight: 700;
  font-size: 1.125rem;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  letter-spacing: 0.5px;
}
.jmr-reviewer-meta { flex: 1; min-width: 0; }
.jmr-reviewer-name-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 0.5rem;
  margin-bottom: 0.35rem;
}
.jmr-reviewer-name {
  font-weight: 700;
  font-size: 1.375rem;
  color: #0f172a;
}
.jmr-vp-badge {
  display: flex;
  align-items: center;
  gap: 5px;
  font-size: 1.25rem;
  font-weight: 600;
  color: #16a34a;
}
.jmr-vp-badge svg { width: 18px; height: 18px; }
.jmr-purchase-line {
  font-size: 1.25rem;
  color: #64748b;
  margin-bottom: 0.2rem;
}
.jmr-location-line {
  font-size: 1.25rem;
  color: #64748b;
}
.jmr-rating-date {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 0.25rem;
  flex-shrink: 0;
}
.jmr-review-stars {
  color: #f59e0b;
  font-size: 1.875rem;
  letter-spacing: 2px;
  line-height: 1;
}
.jmr-review-date {
  font-size: 1.25rem;
  color: #94a3b8;
  white-space: nowrap;
}
.jmr-review-title {
  font-size: 1.625rem;
  font-weight: 700;
  color: #0f172a;
  margin-bottom: 0.75rem;
  line-height: 1.35;
}
.jmr-review-body {
  font-size: 1.375rem;
  color: #374151;
  line-height: 1.8;
  margin-bottom: 1.5rem;
}
.jmr-review-actions {
  display: flex;
  align-items: center;
  gap: 2rem;
  padding-top: 0.5rem;
}
.jmr-action-btn {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  font-size: 1.25rem;
  color: #64748b;
  background: none;
  border: none;
  cursor: pointer;
  padding: 0;
  transition: color 0.15s;
}
.jmr-action-btn:hover { color: #1a4fa3; }
.jmr-action-btn svg { width: 20px; height: 20px; }
.jmr-action-btn.jmr-helpful-voted { color: #1a4fa3; font-weight: 600; }
.jmr-action-btn.jmr-helpful-voted svg { stroke: #1a4fa3; }
.jmr-action-btn.jmr-reported-done { color: #94a3b8; cursor: default; pointer-events: none; }

/* ── Report modal ── */
.jmr-report-overlay {
  position: fixed;
  inset: 0;
  background: rgba(15,23,42,0.55);
  z-index: 9999;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 1.5rem;
  backdrop-filter: blur(2px);
}
.jmr-report-overlay[hidden] { display: none !important; }
.jmr-report-modal {
  background: #fff;
  border-radius: 18px;
  width: 100%;
  max-width: 600px;
  box-shadow: 0 24px 64px rgba(15,23,42,0.28);
  overflow: hidden;
}
.jmr-report-modal-header {
  background: #1e3a6e;
  padding: 1.75rem 2.25rem;
  display: flex;
  align-items: center;
  gap: 1rem;
}
.jmr-report-modal-header svg {
  width: 32px;
  height: 32px;
  flex-shrink: 0;
  color: #93c5fd;
}
.jmr-report-modal-title {
  font-size: 1.9rem;
  font-weight: 700;
  color: #fff;
  flex: 1;
}
.jmr-report-modal-body {
  padding: 2rem 2.25rem 2.25rem;
}
.jmr-report-modal-sub {
  font-size: 1.4rem;
  color: #64748b;
  margin-bottom: 1.25rem;
}
.jmr-report-options { display: flex; flex-direction: column; gap: 0.65rem; margin-bottom: 1.75rem; }
.jmr-report-option {
  display: flex;
  align-items: center;
  gap: 1rem;
  padding: 1rem 1.25rem;
  border: 1.5px solid #e2e8f0;
  border-radius: 10px;
  cursor: pointer;
  transition: border-color 0.15s, background 0.15s;
  font-size: 1.4rem;
  color: #374151;
  user-select: none;
  background: #f8fafc;
}
.jmr-report-option:hover { border-color: #2a74af; background: #eff6ff; color: #1e3a6e; }
.jmr-report-option.selected { border-color: #2a74af; background: #dbeafe; color: #1e3a6e; font-weight: 600; }
.jmr-report-option input[type="radio"] { width: 20px; height: 20px; accent-color: #1e3a6e; flex-shrink: 0; cursor: pointer; }
.jmr-report-suggested {
  margin-left: auto;
  font-size: 1.1rem;
  font-weight: 700;
  color: #1e3a6e;
  background: #bfdbfe;
  padding: 0.2rem 0.75rem;
  border-radius: 99px;
  letter-spacing: 0.01em;
  white-space: nowrap;
}
.jmr-report-modal-footer {
  display: flex;
  gap: 0.9rem;
  justify-content: flex-end;
  padding-top: 0.25rem;
}
.jmr-report-cancel-btn {
  padding: 0.9rem 1.75rem;
  border: 1.5px solid #cbd5e1;
  border-radius: 10px;
  background: #fff;
  color: #475569;
  font-size: 1.3rem;
  font-weight: 600;
  cursor: pointer;
  font-family: inherit;
  transition: border-color 0.15s, background 0.15s;
}
.jmr-report-cancel-btn:hover { border-color: #94a3b8; background: #f8fafc; }
.jmr-report-submit-btn {
  padding: 0.9rem 1.75rem;
  background: #1e3a6e;
  border: none;
  border-radius: 10px;
  color: #fff;
  font-size: 1.3rem;
  font-weight: 700;
  cursor: pointer;
  font-family: inherit;
  transition: background 0.15s, opacity 0.15s;
}
.jmr-report-submit-btn:hover:not(:disabled) { background: #2a74af; }
.jmr-report-submit-btn:disabled { opacity: 0.4; cursor: not-allowed; }

/* ── Pagination ── */
.jmr-pagination {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 1rem;
  margin-top: 1.75rem;
  padding-top: 1.5rem;
  border-top: 1px solid #e2e8f0;
}
.jmr-page-btn {
  display: flex;
  align-items: center;
  gap: 0.4rem;
  padding: 0.6rem 1.4rem;
  border: 1.5px solid #e2e8f0;
  border-radius: 8px;
  background: #fff;
  color: #374151;
  font-size: 1.2rem;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.15s;
}
.jmr-page-btn:hover:not(:disabled) { border-color: #1a4fa3; color: #1a4fa3; }
.jmr-page-btn:disabled { opacity: 0.35; cursor: not-allowed; }
.jmr-page-info {
  font-size: 1.2rem;
  color: #64748b;
  font-weight: 500;
  min-width: 90px;
  text-align: center;
}

/* ── Write a review CTA ── */
.jmr-cta {
  margin-top: 2rem;
  margin-left: 6rem;
  margin-right: 6rem;
  display: flex;
  align-items: center;
  gap: 1.75rem;
  padding: 1.5rem 1.75rem;
  border: 1px solid #e2e8f0;
  border-radius: 14px;
  background: #f8fafc;
}
.jmr-cta-ico {
  width: 72px;
  height: 66px;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.jmr-cta-ico svg { width: 72px; height: 66px; }
.jmr-cta-text { flex: 1; }
.jmr-cta-text strong {
  display: block;
  font-size: 1.75rem;
  font-weight: 700;
  color: #0f172a;
  margin-bottom: 0.3rem;
}
.jmr-cta-text p { font-size: 1.25rem; color: #374151 !important; }
.jmr-cta-btn {
  display: inline-block;
  padding: 0.85rem 1.5rem;
  background: #2563eb;
  color: #fff;
  font-weight: 700;
  font-size: 1.35rem;
  border-radius: 10px;
  text-decoration: none;
  white-space: nowrap;
  transition: background 0.15s;
  border: none;
  cursor: pointer;
  flex-shrink: 0;
}
.jmr-cta-btn:hover { background: #1d4ed8; color: #fff; }

/* ── Write Review Modal ── */
.jmr-wr-overlay {
  position: fixed;
  inset: 0;
  background: rgba(15,23,42,0.55);
  z-index: 9998;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 1.5rem;
  backdrop-filter: blur(2px);
}
.jmr-wr-overlay[hidden] { display: none !important; }
.jmr-wr-modal {
  background: #fff;
  border-radius: 18px;
  width: 100%;
  max-width: 580px;
  box-shadow: 0 24px 64px rgba(15,23,42,0.28);
  overflow: hidden;
}
.jmr-wr-header {
  background: #1e3a6e;
  padding: 1.5rem 2rem;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
}
.jmr-wr-header-left { flex: 1; }
.jmr-wr-title {
  font-size: 1.75rem;
  font-weight: 700;
  color: #fff;
  margin-bottom: 0.15rem;
}
.jmr-wr-product {
  font-size: 1.1rem;
  color: #93c5fd;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 380px;
}
.jmr-wr-close {
  background: rgba(255,255,255,0.12);
  border: none;
  border-radius: 8px;
  color: #fff;
  width: 36px;
  height: 36px;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  flex-shrink: 0;
  font-size: 1.4rem;
  transition: background 0.15s;
}
.jmr-wr-close:hover { background: rgba(255,255,255,0.22); }
.jmr-wr-body { padding: 1.75rem 2rem; display: flex; flex-direction: column; gap: 1.1rem; }
.jmr-wr-stars-label { font-size: 1.2rem; font-weight: 600; color: #374151; margin-bottom: 0.4rem; }
.jmr-wr-stars {
  display: flex;
  gap: 0.35rem;
  flex-direction: row-reverse;
  width: fit-content;
}
.jmr-wr-stars input { display: none; }
.jmr-wr-stars label {
  font-size: 2.8rem;
  color: #d1d5db;
  cursor: pointer;
  line-height: 1;
  transition: color 0.1s;
}
.jmr-wr-stars label:hover,
.jmr-wr-stars label:hover ~ label,
.jmr-wr-stars input:checked ~ label { color: #fbbf24; }
.jmr-wr-row { display: grid; grid-template-columns: 1fr 1fr; gap: 0.9rem; }
.jmr-wr-field {
  display: flex;
  flex-direction: column;
  gap: 0.35rem;
}
.jmr-wr-field label { font-size: 1.15rem; font-weight: 600; color: #374151; }
.jmr-wr-field input,
.jmr-wr-field textarea {
  padding: 0.75rem 1rem;
  border: 1.5px solid #e2e8f0;
  border-radius: 9px;
  font-size: 1.25rem;
  font-family: inherit;
  color: #0f172a;
  background: #f8fafc;
  transition: border-color 0.15s;
  outline: none;
  resize: none;
}
.jmr-wr-field input:focus,
.jmr-wr-field textarea:focus { border-color: #2a74af; background: #fff; }
.jmr-wr-field textarea { min-height: 110px; }
.jmr-wr-footer {
  display: flex;
  gap: 0.9rem;
  justify-content: flex-end;
  padding: 0 2rem 1.75rem;
}
.jmr-wr-cancel {
  padding: 0.8rem 1.6rem;
  border: 1.5px solid #cbd5e1;
  border-radius: 9px;
  background: #fff;
  color: #475569;
  font-size: 1.2rem;
  font-weight: 600;
  cursor: pointer;
  font-family: inherit;
  transition: border-color 0.15s;
}
.jmr-wr-cancel:hover { border-color: #94a3b8; }
.jmr-wr-submit {
  padding: 0.8rem 1.75rem;
  background: #1e3a6e;
  border: none;
  border-radius: 9px;
  color: #fff;
  font-size: 1.2rem;
  font-weight: 700;
  cursor: pointer;
  font-family: inherit;
  transition: background 0.15s, opacity 0.15s;
}
.jmr-wr-submit:hover:not(:disabled) { background: #2a74af; }
.jmr-wr-submit:disabled { opacity: 0.45; cursor: not-allowed; }
.jmr-wr-success {
  padding: 2.5rem 2rem;
  text-align: center;
  display: none;
}
.jmr-wr-success svg { width: 56px; height: 56px; color: #16a34a; margin: 0 auto 1rem; display: block; }
.jmr-wr-success h3 { font-size: 1.75rem; font-weight: 700; color: #0f172a; margin-bottom: 0.5rem; }
.jmr-wr-success p { font-size: 1.2rem; color: #64748b; }
.jmr-wr-error { font-size: 1.1rem; color: #dc2626; margin-top: 0.25rem; display: none; }

/* ── Responsive ── */
/* ── No reviews empty state ── */
.jmr-no-reviews-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  padding: 3rem 2rem 4rem;
  border: 1.5px dashed #cbd5e1;
  border-radius: 14px;
  margin-bottom: 3rem;
}
.jmr-no-reviews-icon {
  color: #94a3b8;
  margin-bottom: 1.25rem;
}
.jmr-no-reviews-title {
  font-size: 2rem;
  font-weight: 700;
  color: #0f172a;
  margin-bottom: 0.6rem;
}
.jmr-no-reviews-sub {
  font-size: 1.35rem;
  color: #64748b;
  max-width: 480px;
  margin: 0 auto 2rem;
  line-height: 1.7;
  text-align: center;
}

@media (max-width: 749px) {
  .jmr-summary { grid-template-columns: 1fr; }
  .jmr-overall { border-right: none; border-bottom: 1px solid rgba(255,255,255,0.2); padding: 2rem 1.75rem; }
  .jmr-breakdown { padding: 2rem 1.75rem; }
  .jmr-big-num { font-size: 4rem; }
  .jmr-bar-meta { width: 95px; font-size: 0.92rem; }
  .jmr-header { flex-direction: column; gap: 0.5rem; }
  .jmr-cta { flex-direction: column; text-align: center; gap: 1rem; margin-left: 0; margin-right: 0; }
  .jmr-cta-btn { align-self: center; }
  .jmr-rating-date { flex-direction: row; align-items: center; gap: 0.75rem; width: 100%; margin-top: 0.25rem; }
  .jmr-review-top { flex-wrap: wrap; }
  .jmr-reviewer-name { font-size: 1.125rem; }
  .jmr-vp-badge { font-size: 1rem; }
  .jmr-purchase-line, .jmr-location-line, .jmr-review-date { font-size: 1rem; }
  .jmr-review-stars { font-size: 1.375rem; }
  .jmr-review-title { font-size: 1.25rem; }
  .jmr-review-body { font-size: 1.125rem; }
  .jmr-action-btn { font-size: 1rem; }
  .jmr-photos-hd h3 { font-size: 1.4rem; }
  .jmr-photos-hd a { font-size: 1.1rem; }
  .jmr-photo-tile, .jmr-photo-more { width: 100px; height: 100px; }
}
{%- endstyle -%}

{%- comment -%} ── Pre-compute rating distribution from scraped metafield ── {%- endcomment -%}
{%- assign _meta_reviews = nil -%}
{%- assign _sum_ct5 = 0 -%}
{%- assign _sum_ct4 = 0 -%}
{%- assign _sum_ct3 = 0 -%}
{%- assign _sum_ct2 = 0 -%}
{%- assign _sum_ct1 = 0 -%}
{%- if _meta_reviews != blank and _meta_reviews.size > 0 -%}
  {%- assign _total_reviews = _meta_reviews.size -%}
  {%- for _rv_item in _meta_reviews -%}
    {%- assign _rv_stars = _rv_item.rating | plus: 0 -%}
    {%- case _rv_stars -%}
      {%- when 5 -%}{%- assign _sum_ct5 = _sum_ct5 | plus: 1 -%}
      {%- when 4 -%}{%- assign _sum_ct4 = _sum_ct4 | plus: 1 -%}
      {%- when 3 -%}{%- assign _sum_ct3 = _sum_ct3 | plus: 1 -%}
      {%- when 2 -%}{%- assign _sum_ct2 = _sum_ct2 | plus: 1 -%}
      {%- when 1 -%}{%- assign _sum_ct1 = _sum_ct1 | plus: 1 -%}
    {%- endcase -%}
  {%- endfor -%}
  {%- assign _pct5 = _sum_ct5 | times: 100.0 | divided_by: _total_reviews | round -%}
  {%- assign _pct4 = _sum_ct4 | times: 100.0 | divided_by: _total_reviews | round -%}
  {%- assign _pct3 = _sum_ct3 | times: 100.0 | divided_by: _total_reviews | round -%}
  {%- assign _pct2 = _sum_ct2 | times: 100.0 | divided_by: _total_reviews | round -%}
  {%- assign _pct1 = _sum_ct1 | times: 100.0 | divided_by: _total_reviews | round -%}
  {%- assign _w5 = _sum_ct5 | times: 5 -%}
  {%- assign _w4 = _sum_ct4 | times: 4 -%}
  {%- assign _w3 = _sum_ct3 | times: 3 -%}
  {%- assign _w2 = _sum_ct2 | times: 2 -%}
  {%- assign _rating_sum = _w5 | plus: _w4 | plus: _w3 | plus: _w2 | plus: _sum_ct1 -%}
  {%- assign _avg_rating = _rating_sum | times: 1.0 | divided_by: _total_reviews | round: 1 -%}
  {%- assign _fg_width = _avg_rating | times: 20 | round -%}
{%- else -%}
  {%- assign _no_reviews = true -%}
  {%- assign _total_reviews = 0 -%}
  {%- assign _sum_ct5 = 0 -%}
  {%- assign _sum_ct4 = 0 -%}
  {%- assign _sum_ct3 = 0 -%}
  {%- assign _sum_ct2 = 0 -%}
  {%- assign _sum_ct1 = 0 -%}
  {%- assign _pct5 = 0 -%}
  {%- assign _pct4 = 0 -%}
  {%- assign _pct3 = 0 -%}
  {%- assign _pct2 = 0 -%}
  {%- assign _pct1 = 0 -%}
  {%- assign _avg_rating = 0.0 -%}
  {%- assign _fg_width = 0 -%}
{%- endif -%}

<span id="judgeme-reviews" style="display:block;height:0;"></span>
<div id="jmr-{{ section.id }}" class="page-width">

  {%- comment -%} ── Section header ── {%- endcomment -%}
  <div class="jmr-header">
    <div>
      <h2>Customer Reviews</h2>
      <p class="jmr-header-sub">Real feedback from verified HVAC buyers</p>
    </div>
    <div class="jmr-verified-badge">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
        <polyline points="9 12 11 14 15 10"/>
      </svg>
      Verified Purchases Only
    </div>
  </div>

  {%- comment -%} ── Rating summary ── {%- endcomment -%}
  <div class="jmr-summary">
    <div class="jmr-overall">
      {%- if _no_reviews -%}
        <div class="jmr-big-num" style="font-size:3rem;opacity:0.55;">—</div>
        <div class="jmr-star-display" aria-label="No reviews yet">
          <div class="bg" style="color:rgba(255,255,255,0.25);">★★★★★</div>
        </div>
        <div class="jmr-out-of">out of 5</div>
        <div class="jmr-total-ct">No reviews yet</div>
      {%- else -%}
        <div class="jmr-big-num">{{ _avg_rating }}</div>
        <div class="jmr-star-display" aria-label="{{ _avg_rating }} out of 5 stars">
          <div class="bg">★★★★★</div>
          <div class="fg" aria-hidden="true" style="width:{{ _fg_width }}%">★★★★★</div>
        </div>
        <div class="jmr-out-of">out of 5</div>
        <div class="jmr-total-ct">Based on {{ _total_reviews }} reviews</div>
      {%- endif -%}
    </div>
    <div class="jmr-breakdown">
      <div class="jmr-bar-row">
        <span class="jmr-bar-lbl">5 <span class="s">★</span></span>
        <progress class="jmr-bar" value="{{ _pct5 }}" max="100"></progress>
        <span class="jmr-bar-meta"><span class="jmr-pct">{{ _pct5 }}%</span> <span class="jmr-ct">({{ _sum_ct5 }})</span></span>
      </div>
      <div class="jmr-bar-row">
        <span class="jmr-bar-lbl">4 <span class="s">★</span></span>
        <progress class="jmr-bar" value="{{ _pct4 }}" max="100"></progress>
        <span class="jmr-bar-meta"><span class="jmr-pct">{{ _pct4 }}%</span> <span class="jmr-ct">({{ _sum_ct4 }})</span></span>
      </div>
      <div class="jmr-bar-row">
        <span class="jmr-bar-lbl">3 <span class="s">★</span></span>
        <progress class="jmr-bar" value="{{ _pct3 }}" max="100"></progress>
        <span class="jmr-bar-meta"><span class="jmr-pct">{{ _pct3 }}%</span> <span class="jmr-ct">({{ _sum_ct3 }})</span></span>
      </div>
      <div class="jmr-bar-row">
        <span class="jmr-bar-lbl">2 <span class="s">★</span></span>
        <progress class="jmr-bar" value="{{ _pct2 }}" max="100"></progress>
        <span class="jmr-bar-meta"><span class="jmr-pct">{{ _pct2 }}%</span> <span class="jmr-ct">({{ _sum_ct2 }})</span></span>
      </div>
      <div class="jmr-bar-row">
        <span class="jmr-bar-lbl">1 <span class="s">★</span></span>
        <progress class="jmr-bar" value="{{ _pct1 }}" max="100"></progress>
        <span class="jmr-bar-meta"><span class="jmr-pct">{{ _pct1 }}%</span> <span class="jmr-ct">({{ _sum_ct1 }})</span></span>
      </div>
    </div>
  </div>

  {%- comment -%} ── Customer photos gallery (centered, no labels) ── {%- endcomment -%}
  {%- unless _no_reviews -%}
  <div class="jmr-photos">
    <div class="jmr-photos-hd">
      <h3>Customer Photos</h3>
      <a href="#" aria-label="View all customer photos">View all photos &rarr;</a>
    </div>
    <div class="jmr-photos-row">
      {%- for img in product.images limit: 5 -%}
        <div class="jmr-photo-tile" data-index="{{ forloop.index0 }}" data-full="{{ img | image_url: width: 1200 }}" role="button" tabindex="0" aria-label="View customer photo {{ forloop.index }}">
          <img
            src="{{ img | image_url: width: 280, height: 280, crop: 'center' }}"
            alt="Customer photo {{ forloop.index }}"
            loading="lazy"
            width="140"
            height="140"
          >
        </div>
      {%- endfor -%}
      <div class="jmr-photo-more">
        <span>+232</span>
        <small>More photos</small>
      </div>
    </div>
  </div>
  {%- endunless -%}

  {%- comment -%} ── Option detection (must run before filter panel HTML) ── {%- endcomment -%}
  {%- assign _has_tonnage = false -%}
  {%- assign _has_seer2 = false -%}
  {%- assign _tonnage_opt_idx = 0 -%}
  {%- assign _seer2_opt_idx = 0 -%}
  {%- assign _tonnage_values = '' -%}
  {%- assign _seer2_values = '' -%}
  {%- for _opt in product.options_with_values -%}
    {%- assign _oname = _opt.name | downcase -%}
    {%- if _oname contains 'ton' or _oname contains 'capacity' -%}
      {%- assign _has_tonnage = true -%}
      {%- assign _tonnage_opt_idx = forloop.index0 -%}
      {%- assign _tonnage_values = _opt.values -%}
    {%- endif -%}
    {%- if _oname contains 'seer' -%}
      {%- assign _has_seer2 = true -%}
      {%- assign _seer2_opt_idx = forloop.index0 -%}
      {%- assign _seer2_values = _opt.values -%}
    {%- endif -%}
  {%- endfor -%}

  {%- comment -%} ── Filter tabs (hidden when no reviews) ── {%- endcomment -%}
  {%- unless _no_reviews -%}
  <div class="jmr-filters-outer">
    <div class="jmr-filters" role="group" aria-label="Review filters">
      <button class="jmr-filter-btn active" type="button">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
        Most Recent
      </button>
      <button class="jmr-filter-btn" type="button">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
        Highest Rated
      </button>
      <button class="jmr-filter-btn jmr-filter-right jmr-filters-toggle" type="button" aria-haspopup="true" aria-expanded="false" id="jmr-filter-toggle-{{ section.id }}">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="4" y1="6" x2="20" y2="6"/><line x1="8" y1="12" x2="16" y2="12"/><line x1="11" y1="18" x2="13" y2="18"/></svg>
        <span class="jmr-filters-toggle-label">Filters</span>
        <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
      </button>
    </div>

    <div class="jmr-filter-panel" hidden id="jmr-filter-panel-{{ section.id }}">

      {%- comment -%} Stars accordion {%- endcomment -%}
      <button class="jmr-acc-header" type="button" aria-expanded="false" aria-controls="jmr-acc-stars-{{ section.id }}">
        <span class="jmr-filter-panel-title">Filter by Stars</span>
        <svg class="jmr-acc-caret" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
      </button>
      <div class="jmr-acc-body" id="jmr-acc-stars-{{ section.id }}" hidden>
        <button class="jmr-filter-option active" type="button" data-filter-rating="">All Ratings<svg class="jmr-opt-check" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg></button>
        <button class="jmr-filter-option" type="button" data-filter-rating="5"><span class="jmr-opt-stars">★★★★★</span> 5 Stars<svg class="jmr-opt-check" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg></button>
        <button class="jmr-filter-option" type="button" data-filter-rating="4"><span class="jmr-opt-stars">★★★★</span> 4 Stars<svg class="jmr-opt-check" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg></button>
        <button class="jmr-filter-option" type="button" data-filter-rating="3"><span class="jmr-opt-stars">★★★</span> 3 Stars<svg class="jmr-opt-check" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg></button>
        <button class="jmr-filter-option" type="button" data-filter-rating="2"><span class="jmr-opt-stars">★★</span> 2 Stars<svg class="jmr-opt-check" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg></button>
        <button class="jmr-filter-option" type="button" data-filter-rating="1"><span class="jmr-opt-stars">★</span> 1 Star<svg class="jmr-opt-check" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg></button>
      </div>

      {%- if _has_tonnage -%}
      <hr class="jmr-filter-panel-divider">
      <button class="jmr-acc-header" type="button" aria-expanded="false" aria-controls="jmr-acc-ton-{{ section.id }}">
        <span class="jmr-filter-panel-title">Filter by Tonnage</span>
        <svg class="jmr-acc-caret" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
      </button>
      <div class="jmr-acc-body" id="jmr-acc-ton-{{ section.id }}" hidden>
        <button class="jmr-filter-option active" type="button" data-filter-tonnage="">All Tonnage<svg class="jmr-opt-check" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg></button>
        {%- for _tv in _tonnage_values -%}
        <button class="jmr-filter-option" type="button" data-filter-tonnage="{{ _tv }}">{{ _tv }}<svg class="jmr-opt-check" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg></button>
        {%- endfor -%}
      </div>
      {%- endif -%}

      {%- if _has_seer2 -%}
      <hr class="jmr-filter-panel-divider">
      <button class="jmr-acc-header" type="button" aria-expanded="false" aria-controls="jmr-acc-seer-{{ section.id }}">
        <span class="jmr-filter-panel-title">Filter by SEER2</span>
        <svg class="jmr-acc-caret" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
      </button>
      <div class="jmr-acc-body" id="jmr-acc-seer-{{ section.id }}" hidden>
        <button class="jmr-filter-option active" type="button" data-filter-seer2="">All SEER2<svg class="jmr-opt-check" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg></button>
        {%- for _sv in _seer2_values -%}
        <button class="jmr-filter-option" type="button" data-filter-seer2="{{ _sv }}">{{ _sv }}<svg class="jmr-opt-check" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg></button>
        {%- endfor -%}
      </div>
      {%- endif -%}

