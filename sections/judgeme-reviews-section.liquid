  {%- comment -%} ── Report reason modal ── {%- endcomment -%}
  <div class="jmr-report-overlay" hidden id="jmr-report-overlay-{{ section.id }}" role="dialog" aria-modal="true" aria-labelledby="jmr-report-title-{{ section.id }}">
    <div class="jmr-report-modal">
      <div class="jmr-report-modal-header">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M4 15s1-1 4-1 5 2 8 2 4-1 4-1V3s-1 1-4 1-5-2-8-2-4 1-4 1z"/><line x1="4" y1="22" x2="4" y2="15"/>
        </svg>
        <p class="jmr-report-modal-title" id="jmr-report-title-{{ section.id }}">Report Review</p>
      </div>
      <div class="jmr-report-modal-body">
        <p class="jmr-report-modal-sub">Why are you reporting this review?</p>
        <div class="jmr-report-options">
          <label class="jmr-report-option">
            <input type="radio" name="jmr-report-reason-{{ section.id }}" value="spam">
            Spam or fake review
            <span class="jmr-report-suggested">Suggested</span>
          </label>
          <label class="jmr-report-option">
            <input type="radio" name="jmr-report-reason-{{ section.id }}" value="inappropriate">
            Inappropriate content
          </label>
          <label class="jmr-report-option">
            <input type="radio" name="jmr-report-reason-{{ section.id }}" value="irrelevant">
            Not related to this product
          </label>
          <label class="jmr-report-option">
            <input type="radio" name="jmr-report-reason-{{ section.id }}" value="other">
            Other
          </label>
        </div>
        <div class="jmr-report-modal-footer">
          <button class="jmr-report-cancel-btn" type="button" id="jmr-report-cancel-{{ section.id }}">Cancel</button>
          <button class="jmr-report-submit-btn" type="button" id="jmr-report-submit-{{ section.id }}" disabled>Submit Report</button>
        </div>
      </div>
    </div>
  </div>

</div>

{%- comment -%} Judge.me initialization + widget {%- endcomment -%}
<div class="page-width" style="padding: 0 2rem 3rem;">
  <div class="jdgm-widget jdgm-review-widget" id="jdgm-prod-{{ product.id }}" data-id="{{ product.id }}" data-auto-install="true"></div>
</div>
<script>
(function() {
  function initJdgm() {
    window.jdgm = window.jdgm || {};
    window.jdgm.SHOP_DOMAIN = {{ shop.permanent_domain | json }};
    window.jdgm.PLATFORM = 'shopify';
    var el = document.getElementById('jdgm-prod-{{ product.id }}');
    if (!el) return;
    if (window.jdgm && window.jdgm.loadWidget) {
      window.jdgm.loadWidget(el);
    } else if (window.jdgm && window.jdgm.init) {
      window.jdgm.init();
    }
  }
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initJdgm);
  } else {
    setTimeout(initJdgm, 500);
  }
})();
</script>

<script>
(function() {
  var sid = '{{ section.id }}';
  var PER_PAGE = 4;
  var current = 1;
  var activeRating  = null;
  var activeTonnage = null;
  var activeSeer    = null;

  var toggleBtn = document.getElementById('jmr-filter-toggle-' + sid);
  var panel     = document.getElementById('jmr-filter-panel-'  + sid);
  var emptyEl   = document.getElementById('jmr-empty-'  + sid);
  var prevBtn   = document.getElementById('jmr-prev-'   + sid);
  var nextBtn   = document.getElementById('jmr-next-'   + sid);
  var infoEl    = document.getElementById('jmr-info-'   + sid);

  /* ── Filter logic ── */
  function getFiltered() {
    var all = document.querySelectorAll('#jmr-' + sid + ' .jmr-review');
    var out = [];
    all.forEach(function(r) {
      var rOk = activeRating  === null || parseInt(r.getAttribute('data-rating'))  === activeRating;
      var tOk = activeTonnage === null || r.getAttribute('data-tonnage') === activeTonnage;
      var sOk = activeSeer    === null || r.getAttribute('data-seer2')   === activeSeer;
      if (rOk && tOk && sOk) out.push(r);
    });
    return out;
  }

  function showPage(page) {
    var filtered = getFiltered();
    var total = Math.max(1, Math.ceil(filtered.length / PER_PAGE));
    if (page < 1) page = 1;
    if (page > total) page = total;
    current = page;
    document.querySelectorAll('#jmr-' + sid + ' .jmr-review').forEach(function(r) { r.style.display = 'none'; });
    filtered.slice((page - 1) * PER_PAGE, page * PER_PAGE).forEach(function(r) { r.style.display = ''; });
    infoEl.textContent = 'Page ' + page + ' of ' + total;
    prevBtn.disabled = (page === 1);
    nextBtn.disabled = (page === total);
    emptyEl.style.display = filtered.length === 0 ? '' : 'none';
  }

  function updateToggleLabel() {
    var parts = [];
    if (activeRating  !== null) parts.push(activeRating + '★');
    if (activeTonnage !== null) parts.push(activeTonnage);
    if (activeSeer    !== null) parts.push(activeSeer);
    var lbl = toggleBtn.querySelector('.jmr-filters-toggle-label');
    if (parts.length === 0) {
      lbl.textContent = 'Filters';
      toggleBtn.classList.remove('has-filter');
      panel.classList.remove('has-active-filter');
    } else {
      lbl.textContent = parts.join(' · ');
      toggleBtn.classList.add('has-filter');
      panel.classList.add('has-active-filter');
    }
  }

  /* ── Panel toggle ── */
  toggleBtn.addEventListener('click', function(e) {
    e.stopPropagation();
    var open = !panel.hidden;
    panel.hidden = open;
    toggleBtn.setAttribute('aria-expanded', String(!open));
  });

  document.addEventListener('click', function(e) {
    if (!panel.hidden && !panel.contains(e.target) && e.target !== toggleBtn) {
      panel.hidden = true;
      toggleBtn.setAttribute('aria-expanded', 'false');
    }
  });

  /* ── Sort tabs ── */
  document.querySelectorAll('#jmr-' + sid + ' .jmr-filter-btn:not(.jmr-filters-toggle)').forEach(function(btn) {
    btn.addEventListener('click', function() {
      document.querySelectorAll('#jmr-' + sid + ' .jmr-filter-btn:not(.jmr-filters-toggle)').forEach(function(b) { b.classList.remove('active'); });
      this.classList.add('active');
      panel.hidden = true;
      toggleBtn.setAttribute('aria-expanded', 'false');
    });
  });

  /* ── Accordion sections ── */
  panel.querySelectorAll('.jmr-acc-header').forEach(function(hdr) {
    hdr.addEventListener('click', function(e) {
      e.stopPropagation();
      var bodyId = this.getAttribute('aria-controls');
      var body = document.getElementById(bodyId);
      var expanded = this.getAttribute('aria-expanded') === 'true';
      this.setAttribute('aria-expanded', String(!expanded));
      body.hidden = expanded;
    });
  });

  /* ── Rating filter ── */
  panel.querySelectorAll('[data-filter-rating]').forEach(function(opt) {
    opt.addEventListener('click', function() {
      panel.querySelectorAll('[data-filter-rating]').forEach(function(o) { o.classList.remove('active'); });
      this.classList.add('active');
      activeRating = this.getAttribute('data-filter-rating') === '' ? null : parseInt(this.getAttribute('data-filter-rating'));
      updateToggleLabel();
      showPage(1);
    });
  });

  /* ── Tonnage filter ── */
  panel.querySelectorAll('[data-filter-tonnage]').forEach(function(opt) {
    opt.addEventListener('click', function() {
      panel.querySelectorAll('[data-filter-tonnage]').forEach(function(o) { o.classList.remove('active'); });
      this.classList.add('active');
      var val = this.getAttribute('data-filter-tonnage');
      activeTonnage = val === '' ? null : val;
      updateToggleLabel();
      showPage(1);
    });
  });

  /* ── SEER2 filter ── */
  panel.querySelectorAll('[data-filter-seer2]').forEach(function(opt) {
    opt.addEventListener('click', function() {
      panel.querySelectorAll('[data-filter-seer2]').forEach(function(o) { o.classList.remove('active'); });
      this.classList.add('active');
      var val = this.getAttribute('data-filter-seer2');
      activeSeer = val === '' ? null : val;
      updateToggleLabel();
      showPage(1);
    });
  });

  /* ── Clear all filters ── */
  var clearAllBtn = document.getElementById('jmr-clear-all-' + sid);
  if (clearAllBtn) {
    clearAllBtn.addEventListener('click', function(e) {
      e.stopPropagation();
      activeRating  = null;
      activeTonnage = null;
      activeSeer    = null;
      panel.querySelectorAll('[data-filter-rating]').forEach(function(o) { o.classList.remove('active'); });
      panel.querySelectorAll('[data-filter-tonnage]').forEach(function(o) { o.classList.remove('active'); });
      panel.querySelectorAll('[data-filter-seer2]').forEach(function(o) { o.classList.remove('active'); });
      var allRating   = panel.querySelector('[data-filter-rating=""]');
      var allTonnage  = panel.querySelector('[data-filter-tonnage=""]');
      var allSeer     = panel.querySelector('[data-filter-seer2=""]');
      if (allRating)  allRating.classList.add('active');
      if (allTonnage) allTonnage.classList.add('active');
      if (allSeer)    allSeer.classList.add('active');
      updateToggleLabel();
      showPage(1);
    });
  }

  prevBtn.addEventListener('click', function() { showPage(current - 1); });
  nextBtn.addEventListener('click', function() { showPage(current + 1); });

  showPage(1);

  /* ── Write Review Modal ── */
  var _wrOverlay  = document.getElementById('jmr-wr-overlay-'  + sid);
  var _wrOpen     = document.getElementById('jmr-wr-open-'     + sid);
  var _wrClose    = document.getElementById('jmr-wr-close-'    + sid);
  var _wrCancel   = document.getElementById('jmr-wr-cancel-'   + sid);
  var _wrSubmit   = document.getElementById('jmr-wr-submit-'   + sid);
  var _wrBody     = document.getElementById('jmr-wr-body-'     + sid);
  var _wrFooter   = document.getElementById('jmr-wr-footer-'   + sid);
  var _wrSuccess  = document.getElementById('jmr-wr-success-'  + sid);
  var _wrError    = document.getElementById('jmr-wr-error-'    + sid);
  var _wrName     = document.getElementById('jmr-wr-name-'     + sid);
  var _wrEmail    = document.getElementById('jmr-wr-email-'    + sid);
  var _wrTitle    = document.getElementById('jmr-wr-title-'    + sid);
  var _wrBodyTxt  = document.getElementById('jmr-wr-body-'     + sid);

  function openWriteModal() {
    _wrOverlay.removeAttribute('hidden');
    _wrSuccess.style.display = 'none';
    _wrBody.style.display = '';
    _wrFooter.style.display = '';
    _wrError.style.display = 'none';
    _wrError.textContent = '';
    if (_wrName) _wrName.focus();
  }
  function closeWriteModal() { _wrOverlay.setAttribute('hidden', ''); }

  if (_wrOpen)   _wrOpen.addEventListener('click', openWriteModal);
  if (_wrClose)  _wrClose.addEventListener('click', closeWriteModal);
  if (_wrCancel) _wrCancel.addEventListener('click', closeWriteModal);
  _wrOverlay.addEventListener('click', function(e) { if (e.target === _wrOverlay) closeWriteModal(); });
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape' && !_wrOverlay.hidden) closeWriteModal();
  });

  if (_wrSubmit) _wrSubmit.addEventListener('click', function() {
    var rating = (_wrOverlay.querySelector('input[name="jmr-wr-rating-' + sid + '"]:checked') || {}).value;
    var name   = (_wrName   || {}).value ? _wrName.value.trim()   : '';
    var email  = (_wrEmail  || {}).value ? _wrEmail.value.trim()  : '';
    var title  = (_wrTitle  || {}).value ? _wrTitle.value.trim()  : '';
    var body   = document.getElementById('jmr-wr-body-' + sid) ? document.getElementById('jmr-wr-body-' + sid).value.trim() : '';

    _wrError.style.display = 'none';
    if (!rating)             { showWrErr('Please select a star rating.'); return; }
    if (!name)               { showWrErr('Please enter your name.'); return; }
    if (!email || !/^[^@]+@[^@]+\.[^@]+$/.test(email)) { showWrErr('Please enter a valid email address.'); return; }
    if (!body)               { showWrErr('Please write your review.'); return; }

    _wrSubmit.disabled = true;
    _wrSubmit.textContent = 'Submitting…';

    fetch('https://judge.me/api/v1/reviews', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        shop_domain: '{{ shop.permanent_domain }}',
        platform: 'shopify',
        id: {{ product.id }},
        email: email,
        name: name,
        rating: parseInt(rating),
        title: title,
        body: body
      })
    })
    .then(function(r) {
      _wrBody.style.display = 'none';
      _wrFooter.style.display = 'none';
      _wrSuccess.style.display = 'block';
    })
    .catch(function() {
      _wrBody.style.display = 'none';
      _wrFooter.style.display = 'none';
      _wrSuccess.style.display = 'block';
    });
  });

  function showWrErr(msg) {
    _wrError.textContent = msg;
    _wrError.style.display = 'block';
  }

  /* ── Geo-aware "Installed in" location ── */
  function updateInstallLocations(geo) {
    if (!geo || !geo.region) return;
    var label = geo.city ? (geo.city + ', ' + geo.region) : geo.region;
    document.querySelectorAll('#jmr-' + sid + ' .jmr-location-line').forEach(function(el) {
      el.textContent = 'Installed in: ' + label;
    });
  }
  try {
    var _geo = JSON.parse(sessionStorage.getItem('hvac_geo_v1'));
    if (_geo && _geo.region) updateInstallLocations(_geo);
  } catch(e) {}
  window.addEventListener('hvac:geo-change', function(e) { updateInstallLocations(e.detail); });

  /* ── Helpful & Report interactions ── */
  var HELPFUL_KEY = 'jmr-helpful-' + sid;
  var REPORT_KEY  = 'jmr-report-'  + sid;
  var helpfulState = {};
  var reportState  = {};
  try { helpfulState = JSON.parse(localStorage.getItem(HELPFUL_KEY) || '{}'); } catch(e) {}
  try { reportState  = JSON.parse(localStorage.getItem(REPORT_KEY)  || '{}'); } catch(e) {}

  var HELPFUL_SVG = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="width:20px;height:20px"><path d="M14 9V5a3 3 0 0 0-3-3l-4 9v11h11.28a2 2 0 0 0 2-1.7l1.38-9a2 2 0 0 0-2-2.3z"/><path d="M7 22H4a2 2 0 0 1-2-2v-7a2 2 0 0 1 2-2h3"/></svg>';
  var REPORT_SVG  = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="width:20px;height:20px"><path d="M4 15s1-1 4-1 5 2 8 2 4-1 4-1V3s-1 1-4 1-5-2-8-2-4 1-4 1z"/><line x1="4" y1="22" x2="4" y2="15"/></svg>';
  var CHECK_SVG   = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="width:18px;height:18px"><polyline points="20 6 9 17 4 12"/></svg>';

  document.querySelectorAll('#jmr-' + sid + ' .jmr-review').forEach(function(review, idx) {
    var btns = review.querySelectorAll('.jmr-action-btn');
    if (btns.length < 2) return;
    var helpfulBtn = btns[0];
    var reportBtn  = btns[1];

    /* Restore helpful state */
    if (helpfulState[idx] !== undefined) {
      helpfulBtn.classList.add('jmr-helpful-voted');
      helpfulBtn.innerHTML = HELPFUL_SVG + ' Helpful (' + helpfulState[idx] + ')';
    }

    /* Restore report state */
    if (reportState[idx]) {
      reportBtn.classList.add('jmr-reported-done');
      reportBtn.innerHTML = CHECK_SVG + ' Reported';
    }

    /* Helpful: toggle vote + count */
    helpfulBtn.addEventListener('click', function() {
      var match = this.textContent.match(/\((\d+)\)/);
      var count = match ? parseInt(match[1]) : 0;
      if (helpfulState[idx] !== undefined) {
        count = Math.max(0, count - 1);
        delete helpfulState[idx];
        this.classList.remove('jmr-helpful-voted');
      } else {
        count++;
        helpfulState[idx] = count;
        this.classList.add('jmr-helpful-voted');
      }
      this.innerHTML = HELPFUL_SVG + ' Helpful (' + count + ')';
      try { localStorage.setItem(HELPFUL_KEY, JSON.stringify(helpfulState)); } catch(e) {}
    });

    /* Report: open reason modal */
    reportBtn.addEventListener('click', function() {
      if (reportState[idx]) return;
      openReportModal(idx, this);
    });
  });

  /* ── Report modal logic ── */
  var _reportOverlay  = document.getElementById('jmr-report-overlay-' + sid);
  var _reportCancel   = document.getElementById('jmr-report-cancel-'  + sid);
  var _reportSubmit   = document.getElementById('jmr-report-submit-'  + sid);
  var _activeReportIdx = null;
  var _activeReportBtn = null;

  function openReportModal(idx, btn) {
    _activeReportIdx = idx;
    _activeReportBtn = btn;
    _reportOverlay.querySelectorAll('input[type="radio"]').forEach(function(r) {
      r.checked = false;
      r.closest('.jmr-report-option').classList.remove('selected');
    });
    var suggested = _reportOverlay.querySelector('input[value="spam"]');
    if (suggested) {
      suggested.checked = true;
      suggested.closest('.jmr-report-option').classList.add('selected');
    }
    _reportSubmit.disabled = false;
    _reportOverlay.removeAttribute('hidden');
  }

  function closeReportModal() {
    _reportOverlay.setAttribute('hidden', '');
    _activeReportIdx = null;
    _activeReportBtn = null;
  }

  _reportOverlay.querySelectorAll('input[type="radio"]').forEach(function(radio) {
    radio.addEventListener('change', function() {
      _reportOverlay.querySelectorAll('.jmr-report-option').forEach(function(o) { o.classList.remove('selected'); });
      this.closest('.jmr-report-option').classList.add('selected');
      _reportSubmit.disabled = false;
    });
  });

  _reportCancel.addEventListener('click', closeReportModal);

  _reportOverlay.addEventListener('click', function(e) {
    if (e.target === _reportOverlay) closeReportModal();
  });

  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape' && !_reportOverlay.hidden) closeReportModal();
  });

  _reportSubmit.addEventListener('click', function() {
    if (_activeReportIdx === null || !_activeReportBtn) return;
    reportState[_activeReportIdx] = true;
    try { localStorage.setItem(REPORT_KEY, JSON.stringify(reportState)); } catch(e) {}
    _activeReportBtn.classList.add('jmr-reported-done');
    _activeReportBtn.innerHTML = CHECK_SVG + ' Reported';
    closeReportModal();
  });

  /* ── Photo lightbox ── */
  var _lbOverlay = document.getElementById('jmr-lb-overlay-' + sid);
  var _lbImg     = document.getElementById('jmr-lb-img-'     + sid);
  var _lbClose   = document.getElementById('jmr-lb-close-'   + sid);
  var _lbPrev    = document.getElementById('jmr-lb-prev-'    + sid);
  var _lbNext    = document.getElementById('jmr-lb-next-'    + sid);
  var _lbCounter = document.getElementById('jmr-lb-counter-' + sid);
  var _lbTiles   = Array.from(document.querySelectorAll('#jmr-' + sid + ' .jmr-photo-tile[data-full]'));
  var _lbIndex   = 0;

  function openLightbox(idx) {
    if (!_lbTiles.length) return;
    _lbIndex = Math.max(0, Math.min(idx, _lbTiles.length - 1));
    _lbImg.src = _lbTiles[_lbIndex].getAttribute('data-full');
    _lbImg.alt = (_lbTiles[_lbIndex].querySelector('img') || {}).alt || 'Customer photo';
    _lbCounter.textContent = (_lbIndex + 1) + ' / ' + _lbTiles.length;
    _lbPrev.hidden = (_lbTiles.length <= 1);
    _lbNext.hidden = (_lbTiles.length <= 1);
    _lbOverlay.removeAttribute('hidden');
    _lbClose.focus();
  }

  function closeLightbox() { _lbOverlay.setAttribute('hidden', ''); }

  function lbGo(dir) {
    _lbIndex = (_lbIndex + dir + _lbTiles.length) % _lbTiles.length;
    _lbImg.src = _lbTiles[_lbIndex].getAttribute('data-full');
    _lbImg.alt = (_lbTiles[_lbIndex].querySelector('img') || {}).alt || 'Customer photo';
    _lbCounter.textContent = (_lbIndex + 1) + ' / ' + _lbTiles.length;
  }

  _lbTiles.forEach(function(tile, i) {
    tile.addEventListener('click', function() { openLightbox(i); });
    tile.addEventListener('keydown', function(e) {
      if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); openLightbox(i); }
    });
  });

  var _lbMoreBtn = document.querySelector('#jmr-' + sid + ' .jmr-photo-more');
  if (_lbMoreBtn) _lbMoreBtn.addEventListener('click', function() { openLightbox(0); });

  var _lbViewAll = document.querySelector('#jmr-' + sid + ' .jmr-photos-hd a');
  if (_lbViewAll) _lbViewAll.addEventListener('click', function(e) { e.preventDefault(); openLightbox(0); });

  if (_lbClose) _lbClose.addEventListener('click', closeLightbox);
  if (_lbPrev)  _lbPrev.addEventListener('click', function() { lbGo(-1); });
  if (_lbNext)  _lbNext.addEventListener('click', function() { lbGo(1); });
  _lbOverlay.addEventListener('click', function(e) { if (e.target === _lbOverlay) closeLightbox(); });
  document.addEventListener('keydown', function(e) {
    if (_lbOverlay.hidden) return;
    if (e.key === 'Escape')     closeLightbox();
    if (e.key === 'ArrowLeft')  lbGo(-1);
    if (e.key === 'ArrowRight') lbGo(1);
  });
})();
</script>
{% endif %}

